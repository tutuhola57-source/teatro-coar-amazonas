---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import DireccionSeccion from '../components/DireccionSeccion.astro';
import ObrasCatalogo from '../components/ObrasCatalogo.astro';
import ModalObra from '../components/ModalObra.astro';
import LibretosSection from '../components/LibretosSection.astro';
import ElencoSection from '../components/ElencoSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Teatro COAR Amazonas | Archivo Digital y Libretos"
  description="Plataforma de preservación dramática, cartelera de montajes escénicos y banco de libretos en PDF del Colegio de Alto Rendimiento Amazonas."
>
  <Header />
  <main class="flex-1">
    <Hero />
    <DireccionSeccion />
    <ObrasCatalogo />
    <LibretosSection />
    <ElencoSection />
  </main>
  <Footer />
  <ModalObra />
</Layout>
