---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Teatro COAR Amazonas | Archivo y Memoria Escénica",
  description = "Archivo digital de obras teatrales, registro fotográfico y banco de libretos en PDF del elenco del Colegio de Alto Rendimiento Amazonas."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/coar-logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Cinzel (Teatral / Clásico) & Inter (Lectura limpia) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-stage-950 text-slate-100 font-sans antialiased selection:bg-theatre-gold selection:text-stage-950 min-h-screen flex flex-col">
    <!-- Atmospheric lighting background -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-blue-900/15 rounded-full blur-[140px]"></div>
      <div class="absolute top-[600px] -left-40 w-[500px] h-[500px] bg-theatre-gold/5 rounded-full blur-[160px]"></div>
      <div class="absolute top-[1200px] -right-40 w-[600px] h-[600px] bg-blue-950/20 rounded-full blur-[180px]"></div>
    </div>

    <slot />
  </body>
</html>

<style is:global>
  body {
    background-color: #060b17;
  }
</style>
