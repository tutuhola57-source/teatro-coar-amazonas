---
---
<section id="inicio" class="relative bg-stage-950 overflow-hidden border-b border-stage-800">
  <!-- Theatrical Stage Photo Banner (Maritza Valle Style) -->
  <div class="relative w-full h-[480px] sm:h-[560px] md:h-[620px] lg:h-[680px] bg-black">
    <!-- Authentic Cast Photo -->
    <img
      src={`${import.meta.env.BASE_URL}elenco-principal.png`}
      alt="Elenco de Teatro COAR Amazonas en escena con su Asesor"
      class="w-full h-full object-cover object-center filter brightness-[0.92] contrast-[1.05]"
    />

    <!-- Subtle Theatrical Stage Vignette (Red velvet & dark shadow gradients) -->
    <div class="absolute inset-0 bg-gradient-to-t from-stage-950 via-stage-950/40 to-black/50 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-stage-950/80 via-transparent to-stage-950/80 pointer-events-none"></div>

    <!-- Official Troupe Commemorative Badge (Top Left / Right) -->
    <div class="absolute top-6 left-6 sm:top-8 sm:left-8 z-20">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-stage-950/85 backdrop-blur-md border border-theatre-gold/40 text-theatre-gold text-xs font-semibold uppercase tracking-wider shadow-xl">
        <span class="w-2 h-2 rounded-full bg-theatre-gold animate-pulse"></span>
        Elenco Oficial • COAR Amazonas
      </div>
    </div>

    <!-- Central Overlay Content & Inspirational Quote (Maritza Valle Style) -->
    <div class="absolute inset-x-0 bottom-16 sm:bottom-20 z-20 px-4 sm:px-8 text-center max-w-4xl mx-auto">
      <h1 class="font-theatre text-2xl sm:text-4xl md:text-5xl font-bold text-white tracking-wide leading-tight drop-shadow-[0_4px_16px_rgba(0,0,0,0.85)]">
        Archivo y Memoria Escénica del <span class="text-theatre-gold font-extrabold drop-shadow-[0_0_25px_rgba(245,158,11,0.5)]">Teatro COAR</span>
      </h1>

      <p class="font-theatre italic text-base sm:text-xl text-yellow-100/95 font-medium mt-3 sm:mt-4 drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)] max-w-2xl mx-auto">
        “El arte escénico como reflejo de nuestra identidad, voz y memoria”
      </p>

      <!-- Action Buttons -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        <a
          href="#obras"
          class="px-6 py-2.5 sm:px-8 sm:py-3 rounded-xl text-xs sm:text-sm font-bold uppercase tracking-wider bg-gradient-to-r from-theatre-gold to-yellow-600 text-stage-950 hover:brightness-110 shadow-xl shadow-theatre-gold/20 transition-all"
        >
          🎭 Ver Obras del Elenco
        </a>
        <a
          href="#libretos"
          class="px-6 py-2.5 sm:px-8 sm:py-3 rounded-xl text-xs sm:text-sm font-bold uppercase tracking-wider bg-stage-900/90 hover:bg-stage-850 text-slate-200 border border-theatre-gold/40 hover:border-theatre-gold transition-all"
        >
          📥 Descargar Libretos PDF
        </a>
      </div>
    </div>

    <!-- Carousel Dots Navigation Indicator (Maritza Valle Style) -->
    <div class="absolute bottom-5 inset-x-0 z-20 flex items-center justify-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-theatre-gold shadow-md"></span>
      <span class="w-2 h-2 rounded-full bg-white/40"></span>
      <span class="w-2 h-2 rounded-full bg-white/40"></span>
    </div>
  </div>
</section>
