---
---
<section id="inicio" class="relative bg-stage-950 overflow-hidden border-b border-stage-800">
  <!-- Theatrical Stage Photo Banner -->
  <div class="relative w-full h-[460px] sm:h-[540px] md:h-[600px] lg:h-[660px] bg-black">
    <!-- Principal Theatrical Banner -->
    <img
      src={`${import.meta.env.BASE_URL}elenco-principal.png`}
      alt="Profesor Yaury Arce Gonzales - Dirección Teatral COAR Amazonas"
      class="w-full h-full object-cover object-center filter brightness-[0.98] contrast-[1.02]"
    />

    <!-- Subtle bottom vignette to blend smoothly into the content below -->
    <div class="absolute inset-0 bg-gradient-to-t from-stage-950 via-stage-950/20 to-transparent pointer-events-none"></div>

    <!-- Discreet Minimalist Badge (< 20 words, no buttons) -->
    <div class="absolute inset-x-0 bottom-6 sm:bottom-8 z-20 px-4 flex justify-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-stage-950/85 backdrop-blur-md border border-theatre-gold/35 text-theatre-gold text-xs font-semibold tracking-widest uppercase shadow-2xl">
        <span class="w-1.5 h-1.5 rounded-full bg-theatre-gold animate-pulse"></span>
        Archivo y Memoria Escénica • COAR Amazonas
      </div>
    </div>
  </div>
</section>

