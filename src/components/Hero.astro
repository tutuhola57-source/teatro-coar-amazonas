---
---
<section id="inicio" class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-stage-850/80 border border-theatre-gold/30 text-theatre-gold text-xs font-semibold tracking-wider uppercase mb-6 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-theatre-gold animate-pulse"></span>
        Colegio de Alto Rendimiento Amazonas • Taller de Arte y Escena
      </div>

      <!-- Main Headline -->
      <h1 class="font-theatre text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight sm:leading-tight">
        Archivo y Memoria Escénica del <span class="text-transparent bg-clip-text bg-gradient-to-r from-theatre-gold via-yellow-200 to-theatre-gold">Teatro COAR</span>
      </h1>

      <!-- Description (Strictly grounded, no AI cliches) -->
      <p class="mt-6 text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
        Repositorio oficial de montajes teatrales, registro fotográfico de caracterización y banco de libretos en PDF. Un espacio creado para que cada nueva promoción consulte obras previas, estudie adaptaciones dramáticas y continúe la tradición artística de nuestra institución.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#obras"
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-sm tracking-wide bg-gradient-to-r from-theatre-gold via-yellow-500 to-theatre-gold-dark text-stage-950 hover:brightness-110 shadow-lg shadow-theatre-gold/25 transition-all text-center"
        >
          🎭 Explorar Obras y Montajes
        </a>
        <a
          href="#libretos"
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-sm tracking-wide bg-stage-850 hover:bg-stage-800 text-slate-200 border border-stage-700 hover:border-theatre-gold/50 transition-all text-center"
        >
          📥 Banco de Libretos en PDF
        </a>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="mt-14 pt-8 border-t border-stage-800/80 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="font-theatre text-2xl sm:text-3xl font-bold text-theatre-gold">3.°, 4.° y 5.°</div>
          <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Grados Académicos</div>
        </div>
        <div>
          <div class="font-theatre text-2xl sm:text-3xl font-bold text-white">Clásicos & Contemporáneos</div>
          <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Géneros Representados</div>
        </div>
        <div>
          <div class="font-theatre text-2xl sm:text-3xl font-bold text-theatre-gold">100% Libre</div>
          <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Descarga de Libretos</div>
        </div>
        <div>
          <div class="font-theatre text-2xl sm:text-3xl font-bold text-white">Región Amazonas</div>
          <div class="text-xs text-slate-400 mt-1 uppercase tracking-wider">Identidad Cultural</div>
        </div>
      </div>
    </div>
  </div>
</section>
