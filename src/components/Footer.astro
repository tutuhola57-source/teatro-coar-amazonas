---
import teatroData from '../data/obras.json';
const { institucion } = teatroData;
---

<footer class="mt-auto bg-stage-950 border-t border-stage-800 text-slate-400 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Identity -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-3">
          <img src={`${import.meta.env.BASE_URL}coar-logo.png`} alt="Escudo COAR" class="w-10 h-10 object-contain rounded-full bg-stage-900 border border-theatre-gold/40 p-0.5" />
          <div>
            <h3 class="font-theatre text-base font-bold text-white tracking-wide">{institucion.nombre}</h3>
            <p class="text-xs text-theatre-gold font-semibold">{institucion.taller}</p>
          </div>
        </div>
        <p class="text-slate-400 text-xs leading-relaxed max-w-md">
          Plataforma de preservación dramática y archivo de puestas en escena estudiantiles. Diseñada para garantizar el traspaso intergeneracional del acervo teatral en la región Amazonas.
        </p>
      </div>

      <!-- Col 2: Institutional Links -->
      <div>
        <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Canales Oficiales</h4>
        <ul class="space-y-2">
          <li>
            <a href={institucion.redes.minedu} target="_blank" rel="noopener noreferrer" class="hover:text-theatre-gold transition flex items-center gap-1.5">
              <span>Portal Admisión COAR (MINEDU)</span>
              <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </li>
          <li>
            <a href={institucion.redes.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-theatre-gold transition flex items-center gap-1.5">
              <span>Facebook Colegios de Alto Rendimiento</span>
              <svg class="w-3 h-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Navigation -->
      <div>
        <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider mb-3">Navegación del Taller</h4>
        <ul class="space-y-2">
          <li><a href="#inicio" class="hover:text-theatre-gold transition">Inicio del Archivo</a></li>
          <li><a href="#obras" class="hover:text-theatre-gold transition">Montajes y Obras</a></li>
          <li><a href="#libretos" class="hover:text-theatre-gold transition">Descarga de Libretos</a></li>
          <li><a href="#elenco" class="hover:text-theatre-gold transition">Integrantes y Promociones</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="pt-8 border-t border-stage-850 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500 text-[11px]">
      <p>© {new Date().getFullYear()} Taller de Teatro • Colegio de Alto Rendimiento (COAR) Amazonas. Todos los derechos reservados.</p>
      <div class="flex items-center gap-3">
        <span>Desplegado con Vercel & GitHub</span>
        <span>•</span>
        <span class="text-theatre-gold">Costo Cero Permanente</span>
      </div>
    </div>
  </div>
</footer>
